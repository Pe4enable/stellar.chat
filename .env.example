# Optional. Prefills the service URL in the UI on a fresh browser.
VITE_AUDIT_ENDPOINT=

# Optional. When set, `npm run dev` forwards /audit-service/* to this origin
# so the browser does not have to deal with CORS.
# Example: AUDIT_TARGET=https://audit.example.com
# UI endpoint: /audit-service/v1/audit
AUDIT_TARGET=
